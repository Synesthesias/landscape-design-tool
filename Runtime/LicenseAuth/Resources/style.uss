VisualElement {
}

.unity-text-element {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Packages/com.synesthesias.landscape-design-tool/Runtime/UICommon/Fonts/MPLUSRounded1c-RegularSDF.asset?fileID=11400000&guid=16ebc954c776e604e8d8693a34969fdb&type=2#MPLUSRounded1c-RegularSDF");
}

.IntroductionLabel {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(0, 106, 106);
    margin-bottom: 32px;
    -unity-text-align: center;
}

#logo {
    background-image: resource('logo_plateau');
    width: 368px;
    height: 91px;
}

#Icon_person {
    background-image: resource('Icon_person');
    width: 24px;
    height: 24px;
    margin-right: 12px;
}

#Icon_company {
    background-image: resource('Icon_company');
    width: 24px;
    height: 24px;
    margin-right: 12px;
}

#Icon_mail {
    background-image: resource('Icon_mail');
    width: 24px;
    height: 24px;
    margin-right: 12px;
}

.LoginButton {
    background-color: rgb(0, 106, 106);
    height: 50px;
    border-radius: 25px;
    -unity-text-align: center;
}

.LoginButton:hover {
    background-color: rgb(6, 114, 114);
}

.LoginButton:active {
    background-color: rgb(12, 112, 112);
}

.LoginButton:disabled {
    background-color: rgb(221, 228, 227);
}

.InfoField {
    background-color: rgb(244, 251, 255);
    height: 72px;
    padding: 12px;
    border-radius: 8px;
}

.InfoField label {
    font-size: 18px;
    margin-bottom: 16px;
}

.LightButton {
    height: 50px;
    border-radius: 25px;
    border-color: rgb(128, 213, 212);
    background-color: rgb(128, 213, 212);
    color: rgb(0, 55, 55);
    width: 120px;
    height: 50px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    visibility: visible;
}

.LightButton:hover {
    background-color: rgb(107, 186, 193);
}

.LightButton:active {
    background-color: rgb(85, 163, 173);
}

.LightButton:disabled {
    background-color: rgb(221, 228, 227);
}

.OutlineButton {
    height: 50px;
    border-radius: 25px;
    border-width: 1px;
    border-color: rgb(136, 147, 146);
    background-color: rgba(136, 147, 146, 0);
    color: rgb(12, 112, 112);
    font-size: 10px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    width: 100px;
}

.OutlineButton:hover {
    background-color: rgba(200, 252, 248, 0.4);
}

.OutlineButton:active {
    background-color: rgba(189, 248, 243, 0.4);
}

#ProjectList {
    background-color: rgb(255, 255, 255);
}

#ProjectList:hover {
    background-color: rgb(244, 251, 250);
}

#ProjectList:active {
    background-color: rgba(106, 169, 160, 1);
}


#ProjectList--selected {
    background-color: rgb(244, 251, 250);
}

.CircleButton {
    width: 50px;
    height: 50px;
    border-width: 1px;
    border-radius: 25px;
    margin: 0;
    padding: 0;
}

.unity-radio-button-group__container {
    display: flex;
    flex-direction: row;
}

.unity-radio-button {
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: center;
}

.unity-radio-button__label {
    color: rgb(0, 0, 0);
    font-size: 24px;
}

#UnitDropdown .unity-label {
    color: rgb(0, 0, 0);
    font-size: 18px;
}

#UnitDropdown .unity-base-field__input {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

#UnitDropdown .unity-base-popup-field__text {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    width: 50%;
}

#LogoutButton {
    background-color: rgba(255, 255, 255, 0);
}

#LogoutButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#icon_explore {
    background-image: resource('logo_explore');
}

#Icon_arrow {
    background-image: resource('icon_back-arrow');
}

#Icon_Close {
    background-image: resource('Icon_Close');
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.5);
}
#MessageLabel .unity-text-element{
    color:rgb(0, 0, 0);
}
#MessageLabel .unity-base-text-field__input{
    border-width:0;
}