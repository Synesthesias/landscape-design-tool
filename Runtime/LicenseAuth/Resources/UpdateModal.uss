#ModalWindow{
    background-color:rgba(227, 233, 233, 1);
}
#TitleLabel{
    font-size:32px;
    margin: 16px 0;
    padding: 0;
}
#MessageLabel{
    white-space: normal;
    color: rgb(0, 0, 0);
    font-size:18px;
    margin-bottom:16px;
}
#ActionButton > Label {
    color: rgb(255, 255, 255);
    -unity-font-style:bold;
    font-size:20px;
}
#ActionButton {
    background-color: rgb(0,106, 106);
    height:50px;
    border-radius: 25px!important;
}
.ActionButton:hover {
    background-color: rgb(12, 112, 112);
}

.ActionButton:active {
    background-color: rgb(12, 112, 112);
}

.ActionButton:disabled {
    background-color: rgb(221, 228, 227);
    
}