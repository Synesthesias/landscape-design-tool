.root-elemnt {
	background-color: white;
}

.label-medium-bold {
	color: #000000;
	font-size: 32px;
	unity-font-style: bold;
}

.login-button {
    background-color: rgb(0,106, 106);
	flex-direction: row;
	align-items: center;
	padding: 12px 20px;
	border-radius: 8px;
	border-width: 1px;
	border-color: #ccc;
	border-style: solid;
}

.login-button:hover {
	background-color: rgb(12, 112, 112);
}

.login-button:active {
	background-color: rgb(12, 112, 112);
}

.login-button:disabled {
    background-color: rgb(221, 228, 227);
    
}

.login-button Label {
	color: #FFFFFF;
}